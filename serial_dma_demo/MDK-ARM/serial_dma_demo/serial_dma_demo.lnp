--library_type=microlib --strict --scatter "serial_dma_demo\serial_dma_demo.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "serial_dma_demo.map" -o serial_dma_demo\serial_dma_demo.axf