--cpu=Cortex-M4.fp.sp
"serial_dma_demo\startup_stm32f407xx.o"
"serial_dma_demo\main.o"
"serial_dma_demo\gpio.o"
"serial_dma_demo\dma.o"
"serial_dma_demo\usart.o"
"serial_dma_demo\stm32f4xx_it.o"
"serial_dma_demo\stm32f4xx_hal_msp.o"
"serial_dma_demo\bootloader.o"
"serial_dma_demo\stm32f4xx_hal_uart.o"
"serial_dma_demo\stm32f4xx_hal_rcc.o"
"serial_dma_demo\stm32f4xx_hal_rcc_ex.o"
"serial_dma_demo\stm32f4xx_hal_flash.o"
"serial_dma_demo\stm32f4xx_hal_flash_ex.o"
"serial_dma_demo\stm32f4xx_hal_flash_ramfunc.o"
"serial_dma_demo\stm32f4xx_hal_gpio.o"
"serial_dma_demo\stm32f4xx_hal_dma_ex.o"
"serial_dma_demo\stm32f4xx_hal_dma.o"
"serial_dma_demo\stm32f4xx_hal_pwr.o"
"serial_dma_demo\stm32f4xx_hal_pwr_ex.o"
