--cpu=Cortex-M4.fp.sp
"bootloader_app\startup_stm32f407xx.o"
"bootloader_app\main.o"
"bootloader_app\gpio.o"
"bootloader_app\stm32f4xx_it.o"
"bootloader_app\stm32f4xx_hal_msp.o"
"bootloader_app\stm32f4xx_hal_rcc.o"
"bootloader_app\stm32f4xx_hal_rcc_ex.o"
"bootloader_app\stm32f4xx_hal_flash.o"
"bootloader_app\stm32f4xx_hal_flash_ex.o"
"bootloader_app\stm32f4xx_hal_flash_ramfunc.o"
"bootloader_app\stm32f4xx_hal_gpio.o"
"bootloader_app\stm32f4xx_hal_dma_ex.o"
"bootloader_app\stm32f4xx_hal_dma.o"
"bootloader_app\stm32f4xx_hal_pwr.o"
"bootloader_app\stm32f4xx_hal_pwr_ex.o"
"bootloader_app\stm32f4xx_hal_cortex.o"
"bootloader_app\stm32f4xx_hal.o"
"bootloader_app\stm32f4xx_hal_exti.o"
"bootloader_app\system_stm32f4xx.o"
--strict --scatter "BootLoader_APP\BootLoader_APP.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "BootLoader_APP.map" -o BootLoader_APP\BootLoader_APP.axf