--cpu Cortex-M3
"103demo\startup_stm32f103xb.o"
"103demo\main.o"
"103demo\gpio.o"
"103demo\adc.o"
"103demo\dma.o"
"103demo\usart.o"
"103demo\stm32f1xx_it.o"
"103demo\stm32f1xx_hal_msp.o"
"103demo\stm32f1xx_hal_gpio_ex.o"
"103demo\stm32f1xx_hal_adc.o"
"103demo\stm32f1xx_hal_adc_ex.o"
"103demo\stm32f1xx_hal.o"
"103demo\stm32f1xx_hal_rcc.o"
"103demo\stm32f1xx_hal_rcc_ex.o"
"103demo\stm32f1xx_hal_gpio.o"
"103demo\stm32f1xx_hal_dma.o"
"103demo\stm32f1xx_hal_cortex.o"
"103demo\stm32f1xx_hal_pwr.o"
"103demo\stm32f1xx_hal_flash.o"
"103demo\stm32f1xx_hal_flash_ex.o"
"103demo\stm32f1xx_hal_exti.o"
"103demo\stm32f1xx_hal_uart.o"
"103demo\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "103demo\103demo.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "103demo.map" -o 103demo\103demo.axf